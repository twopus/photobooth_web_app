<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Life4Cut Studio (Immersive)</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&family=Pacifico&display=swap');

        :root {
            --bg-room: #050505; /* Pitch black room for contrast */
            --machine-shell: #f0f0f0;
            --accent: #ff8fab; 
            --studio-light: #ffffff; /* Dynamic Light Color */
            --glow-spread: 50px;
        }

        * { box-sizing: border-box; touch-action: none; user-select: none; -webkit-tap-highlight-color: transparent; }

        body {
            margin: 0; height: 100dvh;
            background-color: var(--bg-room);
            font-family: 'Quicksand', sans-serif;
            display: flex; justify-content: center; align-items: center;
            overflow: hidden;
            /* Subtle floor reflection */
            background-image: radial-gradient(circle at 50% 100%, #222 0%, #000 60%);
        }

        /* --- THE BOOTH (Classic Casing) --- */
        .booth-structure {
            display: flex; flex-direction: column; align-items: center;
            width: 100%; max-width: 500px; height: 96%;
            position: relative;
            transition: transform 0.3s;
        }

        /* 1. TOP LIGHT (The "Sign" Light) */
        .top-light-cap {
            width: 96%; height: 50px; 
            background: var(--studio-light);
            border-radius: 40px 40px 10px 10px; 
            margin-bottom: 8px; z-index: 2;
            /* ULTRA BRIGHT GLOW */
            box-shadow: 
                0 0 20px var(--studio-light), 
                0 0 60px var(--studio-light),
                inset 0 0 20px rgba(255,255,255,0.8);
            border: 4px solid #fff;
            flex-shrink: 0;
            transition: background 0.3s, box-shadow 0.3s;
        }

        /* 2. MAIN CASING */
        .booth-casing {
            flex: 1; width: 100%; 
            background: var(--machine-shell);
            border-radius: 30px; 
            padding: 15px; 
            display: flex; flex-direction: column;
            /* Ambient light reflection on the white casing */
            box-shadow: 
                0 10px 50px rgba(0,0,0,0.8),
                inset 0 0 100px var(--studio-light); /* Light bleeding inside */
            position: relative;
            overflow: hidden;
            transition: box-shadow 0.3s;
        }

        .camera-deco { width: 100%; display: flex; justify-content: center; margin-bottom: 10px; flex-shrink: 0; }
        .lens-circle {
            width: 40px; height: 40px; background: #222; border-radius: 50%;
            border: 3px solid #ccc; position: relative;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        .lens-circle::after {
            content:''; position:absolute; top:30%; left:30%; width:40%; height:40%;
            background:#000; border-radius:50%; border:2px solid #555;
        }

        /* STAGE: Screen + Side Light */
        .main-stage { 
            flex: 1; display: flex; gap: 15px; 
            position: relative; height: 100%; overflow: hidden; 
        }

        /* 3. SIDE LIGHT STRIP (Super Bright) */
        .side-light {
            width: 30px; 
            background: var(--studio-light); 
            border-radius: 20px;
            /* INTENSE GLOW simulating LED strip */
            box-shadow: 
                0 0 30px var(--studio-light), 
                0 0 80px var(--studio-light),
                inset 2px 0 10px rgba(255,255,255,0.9);
            flex-shrink: 0;
            transition: background 0.3s, box-shadow 0.3s;
        }

        /* SCREEN */
        .screen-container {
            flex: 1; background: #fff; border-radius: 20px; 
            overflow: hidden; display: flex; flex-direction: column; 
            border: 6px solid #333; position: relative;
        }

        /* --- APP VIEWS --- */
        .view { flex: 1; display: none; flex-direction: column; width: 100%; height: 100%; background: #fff; }
        .view.active { display: flex; }

        /* START VIEW */
        .view-start { 
            justify-content: center; align-items: center; text-align: center;
            background: radial-gradient(circle, #fff 0%, #fff0f5 100%);
        }
        .view-start h1 {
            font-family: 'Pacifico', cursive; font-size: 3.5rem; 
            color: var(--accent); margin: 0 0 20px 0;
            text-shadow: 3px 3px 0px #eee;
        }
        .btn-start {
            padding: 16px 50px; background: var(--accent); color: white;
            border: none; border-radius: 50px; font-size: 1.4rem; font-weight: bold;
            box-shadow: 0 5px 20px rgba(255, 143, 171, 0.5); cursor: pointer;
        }

        /* CAMERA VIEW */
        .view-camera { background: #000; position: relative; }
        .video-wrap {
            flex: 1; position: relative; overflow: hidden; 
            display: flex; align-items: center; justify-content: center;
        }
        video { 
            width: 100%; height: 100%; object-fit: cover; 
            transform: scaleX(-1); 
        }
        
        /* FACE GLOW OVERLAY (Simulates light hitting user) */
        .face-glow {
            position: absolute; inset: 0; pointer-events: none;
            background: var(--studio-light);
            mix-blend-mode: overlay; /* Blends nicely with video */
            opacity: 0.3; /* Strength of reflection */
            transition: background 0.3s;
        }

        .countdown {
            position: absolute; font-size: 8rem; color: white; 
            font-weight: bold; display: none; 
            text-shadow: 0 0 30px rgba(0,0,0,0.8);
        }

        .controls {
            height: 100px; background: #fff; border-top: 2px solid #eee;
            display: flex; align-items: center; justify-content: space-around;
            padding: 0 10px; flex-shrink: 0;
        }
        .btn-round {
            width: 50px; height: 50px; border-radius: 50%; background: #f5f5f5;
            border: 1px solid #ddd; display: flex; align-items: center; justify-content: center;
        }
        .btn-shutter {
            width: 75px; height: 75px; border-radius: 50%; background: var(--accent);
            border: 5px solid #fff; box-shadow: 0 0 0 2px #eee;
        }
        .btn-shutter:active { transform: scale(0.95); }

        /* EDITOR VIEW */
        .view-editor { background: #f8f8f8; }
        .canvas-area {
            flex: 1; display: flex; align-items: center; justify-content: center;
            padding: 15px; overflow: hidden;
            background-image: radial-gradient(#ddd 1px, transparent 1px); 
            background-size: 20px 20px;
        }
        canvas { max-width: 100%; max-height: 100%; box-shadow: 0 5px 20px rgba(0,0,0,0.15); }

        /* Toolbar */
        .toolbar { background: #fff; display: flex; flex-direction: column; flex-shrink: 0; border-top: 1px solid #eee; }
        
        /* Sub Menus */
        .sub-bar {
            height: 45px; display: none; align-items: center; gap: 10px; 
            padding: 0 15px; overflow-x: auto; background: #fafafa;
            border-bottom: 1px solid #f0f0f0;
        }
        .sub-bar.active { display: flex; }
        .pill {
            padding: 6px 14px; background: white; border: 1px solid #ddd; 
            border-radius: 20px; font-size: 0.8rem; white-space: nowrap; flex-shrink: 0;
        }
        .pill.active { background: var(--accent); color: white; border-color: var(--accent); }
        .color-dot { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1); flex-shrink: 0; }

        /* Main Menu */
        .main-bar {
            display: flex; gap: 5px; padding: 10px 15px; overflow-x: auto;
            scrollbar-width: none;
        }
        .main-bar::-webkit-scrollbar { display: none; }
        .tool {
            display: flex; flex-direction: column; align-items: center; gap: 4px;
            min-width: 60px; color: #555; flex-shrink: 0; cursor: pointer;
        }
        .tool span { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; }

        .icon { width: 24px; height: 24px; fill: currentColor; }
        #file-in { display: none; }

    </style>
</head>
<body>

<div class="booth-structure">
    <div class="top-light-cap"></div>

    <div class="booth-casing">
        <div class="camera-deco"><div class="lens-circle"></div></div>
        
        <div class="main-stage">
            
            <div class="screen-container">
                
                <div id="v-start" class="view view-start active">
                    <h1>Life4Cut</h1>
                    <button class="btn-start" onclick="startCam()">START</button>
                </div>

                <div id="v-cam" class="view view-camera">
                    <div style="position:absolute; top:15px; width:100%; text-align:center; color:white; font-weight:bold; z-index:10; text-shadow:0 1px 3px black;" id="shot-cnt">0 / 4</div>
                    
                    <div class="video-wrap">
                        <video id="video" autoplay playsinline></video>
                        <div class="face-glow"></div>
                        <div class="countdown" id="cd">3</div>
                    </div>

                    <div class="controls">
                        <div class="btn-round" onclick="cycleColor()">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/></svg>
                        </div>
                        <div class="btn-shutter" onclick="startSeq()"></div>
                        <div class="btn-round" onclick="flipCam()">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M15 21h-2v-2h2v2zm4-12h2V7h-2v2zM3 5v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2zm2 0h14v14H5V5zm7 5h2v5h-2z"/></svg>
                        </div>
                    </div>
                </div>

                <div id="v-edit" class="view view-editor">
                    <div class="canvas-area">
                        <canvas id="cvs"></canvas>
                    </div>

                    <div class="toolbar">
                        <div id="sub-layout" class="sub-bar">
                            <div class="pill" onclick="setLayout('strip')">Strip</div>
                            <div class="pill" onclick="setLayout('grid')">Grid</div>
                            <div class="pill" onclick="setLayout('single')">Full</div>
                        </div>
                        <div id="sub-filter" class="sub-bar">
                            <div class="pill" onclick="setFilt('none')">Normal</div>
                            <div class="pill" onclick="setFilt('pure')">Pure</div>
                            <div class="pill" onclick="setFilt('peach')">Peach</div>
                            <div class="pill" onclick="setFilt('mono')">B&W</div>
                            <div class="pill" onclick="setFilt('fade')">Fade</div>
                        </div>
                        <div id="sub-bg" class="sub-bar">
                            <div class="color-dot" style="background:#fff" onclick="setBg('#fff')"></div>
                            <div class="color-dot" style="background:#000" onclick="setBg('#000')"></div>
                            <div class="color-dot" style="background:#ff8fab" onclick="setBg('#ff8fab')"></div>
                            <div class="color-dot" style="background:#bde0fe" onclick="setBg('#bde0fe')"></div>
                            <div class="pill" onclick="document.getElementById('file-in').click()">+ Photo</div>
                        </div>

                        <div class="main-bar">
                            <div class="tool" onclick="showSub('layout')">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
                                <span>Layout</span>
                            </div>
                            <div class="tool" onclick="showSub('filter')">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM8 17h3v-3H8v3zm5-5h3V9h-3v3zm-5 0h3V9H8v3zm5 5h3v-3h-3v3z"/></svg>
                                <span>Filter</span>
                            </div>
                            <div class="tool" onclick="showSub('bg')">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2z"/></svg>
                                <span>Bg</span>
                            </div>
                            <div class="tool" onclick="toggleDraw()">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z"/></svg>
                                <span>Draw</span>
                            </div>
                            <div class="tool" onclick="document.getElementById('file-in').click()">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                                <span>Sticker</span>
                            </div>
                            <div class="tool" onclick="saveImg()">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                                <span>Save</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="side-light"></div>

        </div>
    </div>
    <input type="file" id="file-in" accept="image/*" onchange="handleUp(event)">
</div>

<script>
    const state = {
        photos: [], layout: 'strip', filter: 'none', bg: '#fff', bgImg: null,
        objs: [], drawings: [], isDraw: false, active: null
    };

    // Colors: White, Pink, Blue, Warm, Green
    const colors = ['#ffffff', '#ff8fab', '#a0c4ff', '#ffc09f', '#caffbf'];
    let cIdx = 0;

    const vid = document.getElementById('video');
    const cvs = document.getElementById('cvs');
    const ctx = cvs.getContext('2d');

    function view(id) {
        document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
        document.getElementById(id).classList.add('active');
    }

    async function startCam() {
        try {
            const s = await navigator.mediaDevices.getUserMedia({video:{width:{ideal:1280}, height:{ideal:960}, facingMode:"user"}});
            vid.srcObject = s; view('v-cam');
        } catch(e) { alert("Camera Error"); }
    }

    // --- LIGHT & CAM ---
    function cycleColor() {
        cIdx = (cIdx+1)%colors.length;
        const c = colors[cIdx];
        document.documentElement.style.setProperty('--studio-light', c);
        // Also update border color for "reflection" feel on casing
        document.querySelector('.booth-casing').style.boxShadow = `0 10px 50px rgba(0,0,0,0.8), inset 0 0 100px ${c}`;
    }

    let isMir = true;
    function flipCam() { isMir=!isMir; vid.style.transform=isMir?"scaleX(-1)":"none"; }

    function startSeq() {
        state.photos = [];
        let cnt = 0;
        const cd = document.getElementById('cd');
        
        function tick() {
            cd.style.display='block'; let t=3; cd.innerText=t;
            const i = setInterval(()=>{
                t--; if(t>0) cd.innerText=t;
                else {
                    clearInterval(i); cd.style.display='none';
                    snap(); cnt++;
                    document.getElementById('shot-cnt').innerText = `${cnt} / 4`;
                    if(cnt<4) setTimeout(tick, 1000);
                    else setTimeout(()=>{ view('v-edit'); render(); }, 600);
                }
            }, 800);
        }
        tick();
    }

    function snap() {
        // Flash
        const f = document.createElement('div');
        f.style.cssText="position:absolute;inset:0;background:white;z-index:99;transition:opacity 0.2s";
        document.querySelector('.video-wrap').appendChild(f);
        setTimeout(()=>f.style.opacity=0,50); setTimeout(()=>f.remove(),250);

        const c = document.createElement('canvas');
        c.width=vid.videoWidth; c.height=vid.videoHeight;
        const x = c.getContext('2d');
        if(isMir){ x.translate(c.width,0); x.scale(-1,1); }
        x.drawImage(vid,0,0);
        state.photos.push(c);
    }

    // --- EDITOR ---
    function render() {
        let w, h;
        if(state.layout==='strip') { w=600; h=1800; }
        else if(state.layout==='grid') { w=1200; h=1600; }
        else { w=1200; h=1600; }
        cvs.width=w; cvs.height=h;

        // BG
        if(state.bgImg) {
            const p = ctx.createPattern(state.bgImg,'repeat');
            ctx.fillStyle=p; ctx.fillRect(0,0,w,h);
        } else {
            ctx.fillStyle=state.bg; ctx.fillRect(0,0,w,h);
        }

        // Photos
        let f = 'none';
        if(state.filter==='pure') f='brightness(1.1) contrast(0.95)';
        if(state.filter==='peach') f='sepia(0.1) saturate(1.2) brightness(1.05)';
        if(state.filter==='mono') f='grayscale(1) contrast(1.1)';
        if(state.filter==='fade') f='contrast(0.9) brightness(1.1) sepia(0.1)';
        ctx.filter=f;

        if(state.layout==='strip') {
            const g=30, p=40, pw=w-p*2, ph=(h-p*2-g*3)/4;
            state.photos.forEach((img,i)=>{ if(i<4) dImg(img,p,p+i*(ph+g),pw,ph); });
        } else if(state.layout==='grid') {
            const g=30, p=50, pw=(w-p*2-g)/2, ph=pw*0.75, sy=(h-ph*2-g)/2;
            state.photos.forEach((img,i)=>{ if(i<4) {
                const r=Math.floor(i/2), c=i%2; dImg(img,p+c*(pw+g),sy+r*(ph+g),pw,ph);
            }});
        } else {
            const p=50, pw=w-p*2, ph=pw*0.75;
            if(state.photos[0]) dImg(state.photos[0],p,(h-ph)/2,pw,ph);
        }
        ctx.filter='none';

        // Drawings
        ctx.lineCap='round'; ctx.lineJoin='round';
        state.drawings.forEach(d=>{
            ctx.beginPath(); ctx.strokeStyle='#ff8fab'; ctx.lineWidth=8;
            if(d.p.length) ctx.moveTo(d.p[0].x,d.p[0].y);
            for(let i=1; i<d.p.length; i++) ctx.lineTo(d.p[i].x,d.p[i].y);
            ctx.stroke();
        });

        // Objs
        state.objs.forEach(o=>{
            ctx.save(); ctx.translate(o.x,o.y); ctx.rotate(o.rot); ctx.scale(o.s,o.s);
            ctx.drawImage(o.img,-o.w/2,-o.h/2,o.w,o.h);
            if(state.active===o) { ctx.strokeStyle='#333'; ctx.lineWidth=3; ctx.strokeRect(-o.w/2,-o.h/2,o.w,o.h); }
            ctx.restore();
        });
    }

    function dImg(img,x,y,w,h) {
        ctx.fillStyle="white"; ctx.fillRect(x-10,y-10,w+20,h+20);
        const ri=img.width/img.height, rd=w/h;
        let sw,sh,sx,sy;
        if(ri>rd){ sh=img.height; sw=sh*rd; sx=(img.width-sw)/2; sy=0; }
        else{ sw=img.width; sh=sw/rd; sx=0; sy=(img.height-sh)/2; }
        ctx.drawImage(img,sx,sy,sw,sh,x,y,w,h);
    }

    // --- ACTIONS ---
    function showSub(id) {
        document.querySelectorAll('.sub-bar').forEach(b=>b.classList.remove('active'));
        document.getElementById('sub-'+id).classList.add('active');
        state.isDraw=false; state.active=null; render();
    }
    function toggleDraw() { state.isDraw=!state.isDraw; state.active=null; render(); }
    function setLayout(l) { state.layout=l; render(); }
    function setFilt(f) { state.filter=f; render(); }
    function setBg(c) { state.bg=c; state.bgImg=null; render(); }
    function saveImg() {
        const a=document.createElement('a'); a.download='photo.png'; a.href=cvs.toDataURL(); a.click();
    }
    function handleUp(e) {
        const f=e.target.files[0]; if(!f) return;
        const r=new FileReader();
        r.onload=ev=>{
            const img=new Image();
            img.onload=()=>{
                if(document.getElementById('sub-bg').classList.contains('active')) state.bgImg=img;
                else state.objs.push({img, x:cvs.width/2, y:cvs.height/2, w:300, h:300*(img.height/img.width), rot:0, s:1});
                render();
            };
            img.src=ev.target.result;
        };
        r.readAsDataURL(f); e.target.value='';
    }

    // --- POINTER ---
    let drag=false, lp={x:0,y:0};
    function getP(e) {
        const r=cvs.getBoundingClientRect(); const t=e.touches?e.touches[0]:e;
        return {x:(t.clientX-r.left)*(cvs.width/r.width), y:(t.clientY-r.top)*(cvs.height/r.height)};
    }
    cvs.addEventListener('pointerdown', e=>{
        const p=getP(e);
        if(state.isDraw) { drag=true; state.drawings.push({p:[p]}); render(); return; }
        let h=null;
        for(let i=state.objs.length-1; i>=0; i--) {
            const o=state.objs[i];
            if(Math.abs(p.x-o.x)<o.w/2 && Math.abs(p.y-o.y)<o.h/2) { h=o; break; }
        }
        state.active=h; if(h){ drag=true; lp=p; } render();
    });
    cvs.addEventListener('pointermove', e=>{
        if(!drag) return; const p=getP(e); e.preventDefault();
        if(state.isDraw) { state.drawings[state.drawings.length-1].p.push(p); render(); }
        else if(state.active) { state.active.x+=p.x-lp.x; state.active.y+=p.y-lp.y; lp=p; render(); }
    });
    cvs.addEventListener('pointerup', ()=>drag=false);

</script>
</body>
</html>