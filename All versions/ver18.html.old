<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Cloud Studio Pro</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Bangers&family=Pacifico&family=Playfair+Display:wght@700&family=Quicksand:wght@500;700&family=Roboto+Mono:wght@500&display=swap');

        :root {
            --bg-room: #121212;
            --machine-shell: #f0f0f0;
            --accent: #ffb7b2; 
            --accent-btn: #ff9e99;
            --studio-light: #ffffff;
            --light-int: 1;
            --delete-red: #ff6b6b;
        }

        * { box-sizing: border-box; touch-action: none; user-select: none; -webkit-user-select: none; }

        body {
            margin: 0; height: 100vh; background-color: var(--bg-room);
            font-family: 'Quicksand', sans-serif; /* Consistent rounded font */
            display: flex; justify-content: center; align-items: center;
            background-image: 
                radial-gradient(circle at 50% 30%, var(--studio-light) 0%, transparent 60%),
                radial-gradient(#222 15%, transparent 16%);
            background-size: 100% 100%, 40px 40px;
            background-blend-mode: soft-light, normal;
            overflow: hidden;
            transition: background 0.5s ease;
        }

        /* --- BOOTH STRUCTURE --- */
        .booth-structure {
            display: flex; flex-direction: column; align-items: center;
            width: 100%; max-width: 520px; height: 98vh; position: relative;
        }

        .top-light-cap {
            width: 100%; height: 40px; /* SHORTER TOP */
            background: #fff;
            border-radius: 50px; margin-bottom: 10px; z-index: 2;
            box-shadow: 0 0 calc(30px * var(--light-int)) var(--studio-light);
            border: 4px solid #fff; position: relative;
            opacity: calc(0.8 + (0.2 * var(--light-int)));
        }
        
        .booth-casing {
            flex: 1; width: 100%; background: var(--machine-shell);
            border-radius: 40px; /* MORE ROUNDED */
            padding: 15px; display: flex; flex-direction: column;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5); position: relative;
        }

        .camera-deco { width: 100%; display: flex; justify-content: center; margin-bottom: 5px; }
        .lens-circle {
            width: 30px; height: 30px; background: #333; border-radius: 50%;
            border: 3px solid #ddd; position: relative;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .main-stage { flex: 1; display: flex; gap: 15px; position: relative; height: 100%; overflow: hidden; }

        .side-light {
            width: 25px; background: #fff; border-radius: 20px;
            box-shadow: 0 0 calc(20px * var(--light-int)) var(--studio-light);
            opacity: var(--light-int);
            transition: box-shadow 0.3s, opacity 0.3s;
        }

        .screen-container {
            flex: 1; background: #fff; border-radius: 30px; /* ROUNDED SCREEN */
            position: relative; overflow: hidden; display: flex; flex-direction: column; 
            border: 6px solid #333;
        }

        /* --- VIEWS --- */
        .view { flex: 1; display: none; flex-direction: column; position: relative; background: #fff; width: 100%; height: 100%; }
        .view.active { display: flex; }

        .start-view { justify-content: center; align-items: center; background: radial-gradient(circle at center, #fff 0%, #fff0f5 100%); }
        .logo-cloud { font-size: 5rem; margin-bottom: 10px; animation: float 3s infinite ease-in-out; }
        @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
        
        .btn-main {
            padding: 16px 50px; background: var(--accent-btn); color: white;
            border: none; border-radius: 50px; font-size: 1.1rem; font-weight: 700;
            box-shadow: 0 8px 20px rgba(255, 183, 178, 0.5); cursor: pointer;
            font-family: 'Quicksand', sans-serif;
        }

        .camera-area { flex: 1; position: relative; background: #000; overflow: hidden; border-radius: 20px 20px 0 0; }
        video { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
        .mirrored { transform: scaleX(-1); }
        .countdown {
            position: absolute; top:50%; left:50%; transform:translate(-50%,-50%);
            font-size: 9rem; color: #fff; text-shadow: 0 5px 25px rgba(0,0,0,0.5);
            font-weight: 700; display: none; z-index: 20;
        }

        .cam-ui {
            height: auto; min-height: 160px; background: #fff; display: flex; flex-direction: column;
            align-items: center; justify-content: center; padding: 10px; gap: 8px; border-top: 2px solid #eee;
        }
        
        .shutter-ring {
            width: 70px; height: 70px; border-radius: 50%; border: 4px solid var(--accent);
            padding: 4px; cursor: pointer; transition: transform 0.1s;
        }
        .shutter-ring:active { transform: scale(0.95); }
        .shutter-inner { width: 100%; height: 100%; background: var(--accent); border-radius: 50%; }
        
        .light-picker-btn {
            width: 40px; height: 40px; border-radius: 50%; overflow: hidden;
            border: 3px solid #eee; position: relative;
            background-image: conic-gradient(red, yellow, lime, aqua, blue, magenta, red);
        }
        input[type="color"] { position: absolute; top:-50%; left:-50%; width:200%; height:200%; opacity:0; cursor: pointer; }
        input[type="range"] { accent-color: var(--accent-btn); width: 140px; }

        .btn-small { padding: 8px 15px; background: #eee; border-radius: 20px; font-size: 0.8rem; font-weight: 700; border: none; color: #666; cursor: pointer; font-family: 'Quicksand'; }
        
        /* Select View - CENTERED */
        .select-view { padding: 15px; background: #fafafa; align-items: center; }
        .layout-options, .sub-options { display: flex; gap: 5px; margin-bottom: 5px; justify-content: center; flex-wrap: wrap; width: 100%; }
        .layout-btn, .sub-btn { 
            padding: 8px 15px; border-radius: 20px; /* Rounder */
            border: 1px solid #ddd; background: white; color: #666; font-weight: 700; cursor: pointer; font-family: 'Quicksand';
        }
        .layout-btn.active, .sub-btn.active { background: var(--accent); color: white; border-color: var(--accent); }
        
        .grid-container { 
            display: flex; flex-wrap: wrap; justify-content: center; /* CENTERED GRID */
            gap: 10px; overflow-y: auto; flex: 1; align-content: start; width: 100%;
        }
        .thumb-wrap { 
            width: 100px; height: 120px; /* Fixed size for neatness */
            border-radius: 15px; overflow: hidden; border: 3px solid transparent; 
            cursor: pointer; opacity: 0.6; background: #eee;
        }
        .thumb-wrap.selected { border-color: var(--accent); opacity: 1; transform: scale(1.05); transition: 0.2s; }
        .thumb-wrap img { width: 100%; height: 100%; object-fit: cover; }

        /* --- EDITOR VIEW --- */
        .editor-view { background: #eef; }
        .canvas-area { 
            flex: 1; display: flex; align-items: center; justify-content: center; 
            padding: 20px; overflow: hidden; position: relative; 
        }
        canvas { 
            max-width: 100%; max-height: 100%; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.15); 
            background: white; object-fit: contain; 
        }
        
        .toolbar {
            background: #fff; padding: 15px; border-top: 1px solid #eee;
            display: flex; flex-direction: column; gap: 10px; border-radius: 30px 30px 0 0;
        }

        .tool-section {
            display: flex; gap: 10px; overflow-x: auto; padding-bottom: 5px; scrollbar-width: none; align-items: center; justify-content: center;
        }

        .tool-btn {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            width: 60px; height: 60px; border: 1px solid #eee; border-radius: 20px; /* Rounder */
            background: white; cursor: pointer; gap: 2px; flex-shrink: 0;
            color: #555; font-family: 'Quicksand';
        }
        .tool-btn.active { border-color: var(--accent-btn); background: #fff0f0; }
        .tool-btn span.icon { font-size: 1.4rem; }
        .tool-btn span.label { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; }

        .context-bar {
            background: #f8f8f8; padding: 10px; border-radius: 20px;
            display: none; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
        }
        .context-bar.active { display: flex; }
    </style>
</head>
<body>

<div class="booth-structure">
    <div class="top-light-cap"></div>
    <div class="booth-casing">
        <div class="camera-deco"><div class="lens-circle"></div></div>
        <div class="main-stage">
            <div class="side-light"></div>
            <div class="screen-container">
                
                <div id="view-start" class="view active start-view">
                    <div class="logo-cloud">☁️</div>
                    <h1>Cloud Studio</h1>
                    <button class="btn-main" onclick="startCamera()">Enter Booth</button>
                </div>

                <div id="view-camera" class="view">
                    <div class="camera-area">
                        <video id="video" class="mirrored" autoplay playsinline></video>
                        <div class="countdown" id="countdown">3</div>
                        <div id="flash-fx" style="position:absolute; inset:0; background:white; opacity:0; pointer-events:none;"></div>
                    </div>
                    <div class="cam-ui">
                        <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                            <div id="shot-status" style="font-size:0.8rem; font-weight:700;">0 / 8</div>
                            <button onclick="toggleInvert()" class="btn-small" style="font-size:1.2rem; padding: 4px 10px;">⇄</button>
                        </div>
                        
                        <div style="display:flex; align-items:center; gap:10px; width:100%;">
                            <span style="font-size:0.7rem; font-weight:bold;">DIM</span>
                            <input type="range" min="0" max="1" step="0.1" value="1" oninput="updateIntensity(this.value)">
                            <span style="font-size:0.7rem; font-weight:bold;">BRIGHT</span>
                        </div>

                        <div style="display:flex; align-items:center; justify-content:center; gap: 20px; width: 100%;">
                            <div class="light-picker-btn">
                                <input type="color" oninput="changeStudioLight(this.value)" value="#ffffff">
                            </div>
                            <div id="shutter-btn" class="shutter-ring" onclick="triggerCapture()"><div class="shutter-inner"></div></div>
                            <div style="width:40px;"></div>
                        </div>
                        <button id="btn-finish" class="btn-small" style="background:#444; color:white; width:100%; margin-top:5px; display:none;" onclick="finishSession()">Finish & Edit ➔</button>
                    </div>
                </div>

                <div id="view-select" class="view select-view">
                    <h4 style="text-align:center; margin:0 0 5px 0;">Layout</h4>
                    <div class="layout-options" id="layout-buttons"></div>
                    <div id="sub-options" class="sub-options"></div>

                    <h4 id="select-instruction" style="text-align:center; margin:5px 0;">Select Photos</h4>
                    <div class="grid-container" id="thumb-grid"></div>
                    <button id="btn-confirm" class="btn-main" style="width:100%; opacity: 0.5; pointer-events: none;" onclick="goToEditor()">Design</button>
                </div>

                <div id="view-edit" class="view editor-view">
                    <div class="canvas-area">
                        <canvas id="canvas"></canvas>
                    </div>
                    
                    <div class="toolbar">
                        <div id="draw-menu" class="context-bar">
                            <button class="btn-small" onclick="setBrush('marker')">Marker</button>
                            <button class="btn-small" onclick="setBrush('pencil')">Pencil</button>
                            <button class="btn-small" onclick="setBrush('dotted')">Dashed</button>
                            <button class="btn-small" onclick="setBrush('dots')">Dots</button>
                            <input type="color" value="#000000" onchange="state.drawColor = this.value" style="width:30px; height:30px; border:none; background:none;">
                            <button class="btn-small" style="background:var(--delete-red); color:white;" onclick="toggleDrawMode()">Done</button>
                        </div>

                        <div id="text-menu" class="context-bar">
                             <select onchange="updateActiveFont(this.value)" style="padding:5px; border-radius:10px;">
                                <option value="Quicksand">Std</option>
                                <option value="Pacifico">Cute</option>
                                <option value="Bangers">Comic</option>
                            </select>
                            <input type="color" id="text-color" oninput="updateActiveColor(this.value)" style="width:30px; height:30px;">
                            <button class="btn-small" style="background:var(--delete-red); color:white;" onclick="deleteActiveObject()">Del</button>
                        </div>

                        <div class="tool-section">
                             <div class="tool-btn" style="position: relative;">
                                <span class="icon">🎨</span><span class="label">Color</span>
                                <input type="color" value="#ffffff" style="position:absolute; inset:0; opacity:0;" oninput="setBgColor(this.value)">
                            </div>
                            <div class="tool-btn" style="position: relative;">
                                <span class="icon">🖼️</span><span class="label">Img</span>
                                <input type="file" accept="image/*" style="position:absolute; inset:0; opacity:0;" onchange="setBgImage(event)">
                            </div>

                            <button class="tool-btn" onclick="addText()">
                                <span class="icon">Aa</span><span class="label">Text</span>
                            </button>

                            <button id="btn-draw" class="tool-btn" onclick="toggleDrawMode()">
                                <span class="icon">✏️</span><span class="label">Draw</span>
                            </button>

                            <label class="tool-btn">
                                <span class="icon">📷</span><span class="label">Add Pic</span>
                                <input type="file" hidden accept="image/*" onchange="addPhotoSticker(event)">
                            </label>

                            <button class="tool-btn" onclick="download()">
                                <span class="icon">⬇</span><span class="label">Save</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
            <div class="side-light"></div>
        </div>
    </div>
</div>

<script>
    const CONFIG = { gap: 20 };
    const MAX_SHOTS = 8;
    
    let state = {
        photos: [], 
        selectedIndices: [], 
        targetCount: 4, 
        layoutSubMode: 'grid',
        bgColor: '#ffffff',
        bgImage: null,
        objects: [], 
        activeObj: null,
        isMirrored: true,
        
        // Drawing
        isDrawing: false,
        brushType: 'marker',
        drawColor: '#000000',
        drawPaths: [] 
    };

    const video = document.getElementById('video');
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');

    // --- 1. LIGHTING & CAMERA ---
    function changeStudioLight(color) { document.documentElement.style.setProperty('--studio-light', color); }
    function updateIntensity(val) { document.documentElement.style.setProperty('--light-int', val); }
    function toggleInvert() { state.isMirrored = !state.isMirrored; video.classList.toggle('mirrored', state.isMirrored); }

    async function startCamera() {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
            video.srcObject = stream;
            document.getElementById('view-start').classList.remove('active');
            document.getElementById('view-camera').classList.add('active');
        } catch(e) { alert("Camera access required."); }
    }

    let isCapturing = false;
    function triggerCapture() {
        if(isCapturing || state.photos.length >= MAX_SHOTS) return;
        isCapturing = true;
        document.getElementById('shutter-btn').classList.add('disabled');
        
        let count = 3;
        const countEl = document.getElementById('countdown');
        countEl.style.display = 'block'; countEl.innerText = count;
        
        const timer = setInterval(() => {
            count--;
            if(count > 0) countEl.innerText = count;
            else { 
                clearInterval(timer); 
                countEl.style.display = 'none'; 
                snap(); 
            }
        }, 1000);
    }

    function snap() {
        const flash = document.getElementById('flash-fx');
        flash.style.opacity = 1; setTimeout(() => flash.style.opacity = 0, 150);
        
        const c = document.createElement('canvas');
        c.width = 640; c.height = 480;
        const cx = c.getContext('2d');
        if(state.isMirrored) { cx.translate(640,0); cx.scale(-1,1); }
        
        const vw = video.videoWidth, vh = video.videoHeight;
        const aspect = 640/480;
        let sx, sy, sw, sh;
        if(vw/vh > aspect) { sh = vh; sw = sh*aspect; sy = 0; sx = (vw-sw)/2; }
        else { sw = vw; sh = sw/aspect; sx = 0; sy = (vh-sh)/2; }
        cx.drawImage(video, sx, sy, sw, sh, 0, 0, 640, 480);
        
        state.photos.push(c);
        isCapturing = false;
        document.getElementById('shutter-btn').classList.remove('disabled');
        updateCamUI();
        if(state.photos.length === MAX_SHOTS) finishSession();
    }

    function updateCamUI() {
        document.getElementById('shot-status').innerText = `${state.photos.length} / ${MAX_SHOTS}`;
        document.getElementById('btn-finish').style.display = state.photos.length > 0 ? 'block' : 'none';
    }

    function finishSession() {
        if(video.srcObject) video.srcObject.getTracks().forEach(t => t.stop());
        setupSelectionScreen();
    }

    // --- 2. SELECTION & LAYOUT ---
    function setupSelectionScreen() {
        document.getElementById('view-camera').classList.remove('active');
        document.getElementById('view-select').classList.add('active');
        
        const layoutDiv = document.getElementById('layout-buttons');
        layoutDiv.innerHTML = '';
        [1, 2, 4, 6, 8].filter(n => n <= state.photos.length).forEach(n => {
            const btn = document.createElement('button');
            btn.className = 'layout-btn'; btn.innerText = n;
            btn.onclick = () => setFrameTarget(n, btn);
            if(n === 4 || n === state.photos.length) { btn.click(); } // Auto select logic
            layoutDiv.appendChild(btn);
        });
    }

    function setFrameTarget(n, btnEl) {
        state.targetCount = n;
        document.querySelectorAll('.layout-btn').forEach(b => b.classList.remove('active'));
        if(btnEl) btnEl.classList.add('active');
        state.selectedIndices = [];
        updateSubOptions();
        renderThumbnails(); 
    }

    function updateSubOptions() {
        const subDiv = document.getElementById('sub-options');
        subDiv.innerHTML = '';
        state.layoutSubMode = 'grid'; 

        let opts = [];
        if(state.targetCount === 2) opts = [{l: 'Side-by-Side', v: 'horiz'}, {l: 'Top/Bottom', v: 'vert'}];
        else if (state.targetCount === 4) opts = [{l: 'Grid 2x2', v: 'grid'}, {l: 'Strip 1x4', v: 'strip'}];

        opts.forEach(o => {
            const btn = document.createElement('button');
            btn.className = `sub-btn ${state.layoutSubMode === o.v ? 'active' : ''}`;
            btn.innerText = o.l;
            btn.onclick = () => {
                state.layoutSubMode = o.v;
                document.querySelectorAll('.sub-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            };
            subDiv.appendChild(btn);
        });
    }

    function renderThumbnails() {
        const grid = document.getElementById('thumb-grid'); grid.innerHTML = '';
        state.photos.forEach((photoCanvas, idx) => {
            const wrap = document.createElement('div'); wrap.className = 'thumb-wrap';
            if(state.selectedIndices.includes(idx)) wrap.classList.add('selected');
            const img = new Image(); img.src = photoCanvas.toDataURL();
            wrap.appendChild(img);
            wrap.onclick = () => toggleSelect(idx);
            grid.appendChild(wrap);
        });
        const btn = document.getElementById('btn-confirm');
        if(state.selectedIndices.length === state.targetCount) {
             btn.style.opacity = 1; btn.style.pointerEvents = 'auto';
        } else {
             btn.style.opacity = 0.5; btn.style.pointerEvents = 'none';
        }
        document.getElementById('select-instruction').innerText = `Select ${state.selectedIndices.length} / ${state.targetCount}`;
    }

    function toggleSelect(idx) {
        const i = state.selectedIndices.indexOf(idx);
        if(i > -1) state.selectedIndices.splice(i, 1);
        else if(state.selectedIndices.length < state.targetCount) state.selectedIndices.push(idx);
        renderThumbnails();
    }

    function goToEditor() {
        document.getElementById('view-select').classList.remove('active');
        document.getElementById('view-edit').classList.add('active');
        
        // Canvas Sizing
        const num = state.targetCount;
        const mode = state.layoutSubMode;
        if (num === 4 && mode === 'strip') { canvas.width = 400; canvas.height = 1200; }
        else if (num === 2 && mode === 'vert') { canvas.width = 600; canvas.height = 900; }
        else { canvas.width = 800; canvas.height = 1200; }
        
        renderCanvas(); 
        setupInteractions();
    }

    // --- 3. RENDER & DRAWING ---
    function renderCanvas() {
        const W = canvas.width, H = canvas.height;
        ctx.fillStyle = state.bgColor;
        ctx.fillRect(0,0,W,H);
        
        if(state.bgImage) {
            const img = state.bgImage;
            const r = Math.max(W/img.width, H/img.height);
            const nw = img.width*r, nh = img.height*r;
            ctx.drawImage(img, (W-nw)/2, (H-nh)/2, nw, nh);
        }

        const sel = state.selectedIndices.map(i => state.photos[i]);
        const g = CONFIG.gap;
        
        // Layout Logic
        if(state.targetCount === 1) drawPhoto(sel[0], g, g, W-2*g, H-2*g);
        else if(state.targetCount === 2) {
            if(state.layoutSubMode === 'vert') {
                const h = (H-3*g)/2; drawPhoto(sel[0], g, g, W-2*g, h); drawPhoto(sel[1], g, 2*g+h, W-2*g, h);
            } else {
                const w = (W-3*g)/2; const h=w*0.75; const top=(H-h)/2;
                drawPhoto(sel[0], g, top, w, h); drawPhoto(sel[1], 2*g+w, top, w, h);
            }
        }
        else if(state.targetCount === 4) {
            if(state.layoutSubMode === 'strip') {
                const h = (H-5*g)/4; sel.forEach((p,i)=>drawPhoto(p, g, g+i*(h+g), W-2*g, h));
            } else {
                const w = (W-3*g)/2; const h = w*0.75; const startY = (H-(2*h+g))/2;
                sel.forEach((p,i) => drawPhoto(p, g+(i%2)*(w+g), startY+Math.floor(i/2)*(h+g), w, h));
            }
        }

        // Drawings
        ctx.lineCap = 'round'; ctx.lineJoin = 'round';
        state.drawPaths.forEach(path => {
            ctx.beginPath();
            ctx.strokeStyle = path.color;
            ctx.lineWidth = path.type === 'pencil' ? 2 : 5;
            ctx.globalAlpha = path.type === 'pencil' ? 0.7 : 1.0;
            
            if(path.type === 'dotted') ctx.setLineDash([5, 10]);
            else if(path.type === 'dots') ctx.setLineDash([1, 15]);
            else ctx.setLineDash([]);

            if(path.points.length > 0) {
                ctx.moveTo(path.points[0].x, path.points[0].y);
                for(let i=1; i<path.points.length; i++) ctx.lineTo(path.points[i].x, path.points[i].y);
                ctx.stroke();
            }
            ctx.setLineDash([]); ctx.globalAlpha = 1.0;
        });

        // Objects
        state.objects.forEach(obj => {
            ctx.save();
            ctx.translate(obj.x, obj.y); ctx.rotate(obj.rot || 0); ctx.scale(obj.scale || 1, obj.scale || 1);
            
            if(obj.type === 'text') {
                ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                ctx.font = `bold 50px "${obj.fontFamily}"`; 
                ctx.fillStyle = obj.color;
                ctx.fillText(obj.content, 0, 0);
            } else if (obj.type === 'image') {
                const r = 150/obj.img.width;
                ctx.drawImage(obj.img, -75, -obj.img.height*r/2, 150, obj.img.height*r);
            }

            if(state.activeObj === obj) {
                ctx.strokeStyle = '#ffb7b2'; ctx.lineWidth = 3;
                ctx.strokeRect(-80, -40, 160, 80);
            }
            ctx.restore();
        });
        
        updateToolbarState();
    }

    function drawPhoto(img, x, y, w, h) {
        ctx.save();
        ctx.beginPath(); ctx.rect(x,y,w,h); ctx.clip();
        const r = Math.max(w/img.width, h/img.height);
        ctx.drawImage(img, x+(w-img.width*r)/2, y+(h-img.height*r)/2, img.width*r, img.height*r);
        ctx.restore();
    }

    // --- 4. EDITOR UTILS ---
    function setBgColor(c) { state.bgColor = c; state.bgImage = null; renderCanvas(); }
    function setBgImage(e) {
        const f = e.target.files[0]; if(!f) return;
        const i = new Image(); i.onload = () => { state.bgImage = i; renderCanvas(); };
        i.src = URL.createObjectURL(f);
    }
    
    function addText() { 
        state.isDrawing = false; updateToolbarState();
        const t = prompt("Enter Text:"); 
        if(t) addObject({ type:'text', content:t, fontFamily:'Quicksand', color:'#333333' }); 
    }
    
    function addPhotoSticker(e) {
        state.isDrawing = false; updateToolbarState();
        const f = e.target.files[0]; if(!f) return;
        const img = new Image();
        img.onload = () => addObject({ type:'image', img: img });
        img.src = URL.createObjectURL(f);
    }
    
    function addObject(props) {
        state.objects.push({ x: canvas.width/2, y: canvas.height/2, scale: 1, rot: 0, ...props });
        state.activeObj = state.objects[state.objects.length-1]; 
        renderCanvas();
    }

    function updateActiveFont(font) { if(state.activeObj?.type === 'text') { state.activeObj.fontFamily = font; renderCanvas(); } }
    function updateActiveColor(color) { if(state.activeObj?.type === 'text') { state.activeObj.color = color; renderCanvas(); } }
    function deleteActiveObject() { 
        if(state.activeObj) {
            state.objects = state.objects.filter(o => o !== state.activeObj);
            state.activeObj = null; renderCanvas();
        }
    }

    // DRAWING
    function toggleDrawMode() {
        state.isDrawing = !state.isDrawing;
        if(state.isDrawing) state.activeObj = null;
        updateToolbarState();
    }
    function setBrush(type) { state.brushType = type; }
    function setDrawColor(c) { state.drawColor = c; }

    function updateToolbarState() {
        document.getElementById('draw-menu').classList.toggle('active', state.isDrawing);
        document.getElementById('text-menu').classList.toggle('active', !state.isDrawing && state.activeObj);
        document.getElementById('btn-draw').classList.toggle('active', state.isDrawing);
        renderCanvas();
    }

    function download() {
        state.activeObj = null; renderCanvas();
        const a = document.createElement('a');
        a.download = 'cloud_studio.png'; a.href = canvas.toDataURL(); a.click();
    }

    // --- 5. INTERACTION ---
    function setupInteractions() {
        let isDrag = false;
        let lastP = {x:0, y:0};
        let currentPath = null;

        function getPos(e) {
            const r = canvas.getBoundingClientRect();
            const cx = e.touches ? e.touches[0].clientX : e.clientX;
            const cy = e.touches ? e.touches[0].clientY : e.clientY;
            return { x: (cx - r.left) * (canvas.width / r.width), y: (cy - r.top) * (canvas.height / r.height) };
        }

        canvas.addEventListener('pointerdown', e => {
            const p = getPos(e);
            
            if(state.isDrawing) {
                isDrag = true; 
                currentPath = { points: [p], color: state.drawColor, type: state.brushType };
                state.drawPaths.push(currentPath);
                renderCanvas();
            } else {
                let hit = null;
                for(let i=state.objects.length-1; i>=0; i--) {
                    const o = state.objects[i];
                    if(Math.hypot(p.x - o.x, p.y - o.y) < 80) { hit = o; break; }
                }
                state.activeObj = hit;
                if(hit) { isDrag = true; lastP = p; }
                updateToolbarState();
            }
        });

        canvas.addEventListener('pointermove', e => {
            if(!isDrag) return;
            const p = getPos(e);
            e.preventDefault(); 
            if(state.isDrawing && currentPath) {
                currentPath.points.push(p);
                renderCanvas();
            } else if(state.activeObj) {
                state.activeObj.x += p.x - lastP.x;
                state.activeObj.y += p.y - lastP.y;
                lastP = p;
                renderCanvas();
            }
        });

        canvas.addEventListener('pointerup', () => { isDrag = false; currentPath = null; });
    }
</script>
</body>
</html>